// ── helpers ──────────────────────────────────────────────
const ema = (arr, p) => {
const k = 2 / (p + 1);
let v = arr.slice(0, p).reduce((a, b) => a + b, 0) / p;
for (let i = p; i < arr.length; i++) v = arr[i] * k + v * (1 - k);
return v;
};

const rsi = (closes, p = 14) => {
let g = 0, l = 0;
for (let i = closes.length - p; i < closes.length; i++) {
const d = closes[i] - closes[i - 1];
d > 0 ? (g += d) : (l -= d);
}
const rs = g / p / (l / p || 1e-9);
return 100 - 100 / (1 + rs);
};

const adxCalc = (candles, p = 14) => {
const tr = [], pdm = [], mdm = [];
for (let i = 1; i < candles.length; i++) {
const { high: h, low: l, close: pc } = { …candles[i], pc: candles[i - 1].close };
const prevC = candles[i - 1].close;
tr.push(Math.max(h - l, Math.abs(h - prevC), Math.abs(l - prevC)));
const up = h - candles[i - 1].high, dn = candles[i - 1].low - l;
pdm.push(up > dn && up > 0 ? up : 0);
mdm.push(dn > up && dn > 0 ? dn : 0);
}
const smooth = (a) => {
let s = a.slice(0, p).reduce((x, y) => x + y, 0);
const r = [s];
for (let i = p; i < a.length; i++) { s = s - s / p + a[i]; r.push(s); }
return r;
};
const sTR = smooth(tr), sP = smooth(pdm), sM = smooth(mdm);
const diP = sP.map((v, i) => (v / sTR[i]) * 100);
const diM = sM.map((v, i) => (v / sTR[i]) * 100);
const dx = diP.map((v, i) => Math.abs(v - diM[i]) / ((v + diM[i]) || 1) * 100);
let adxV = dx.slice(0, p).reduce((a, b) => a + b, 0) / p;
for (let i = p; i < dx.length; i++) adxV = (adxV * (p - 1) + dx[i]) / p;
return { adx: adxV, diP: diP[diP.length - 1], diM: diM[diM.length - 1] };
};

const bbWidth = (closes, p = 20) => {
const sl = closes.slice(-p);
const m = sl.reduce((a, b) => a + b) / p;
const std = Math.sqrt(sl.reduce((a, b) => a + (b - m) ** 2, 0) / p);
return (std * 2) / m * 100;
};

const atrCalc = (candles, p = 14) => {
const trs = [];
for (let i = 1; i < candles.length; i++) {
const { high: h, low: l } = candles[i], pc = candles[i - 1].close;
trs.push(Math.max(h - l, Math.abs(h - pc), Math.abs(l - pc)));
}
return trs.slice(-p).reduce((a, b) => a + b) / p;
};

function analyzeMarket(candles) {
const closes = candles.map(c => c.close);
const { adx, diP, diM } = adxCalc(candles);
const bb = bbWidth(closes);
const r = rsi(closes);
const e20 = ema(closes, 20);
const e50 = ema(closes, 50);
const atr = atrCalc(candles);
const price = closes[closes.length - 1];
const change = ((price - closes[closes.length - 25]) / closes[closes.length - 25]) * 100;
const emaDiff = Math.abs((e20 - e50) / e50) * 100;
const atrPct = atr / price * 100;

let regime = “range”, conf = 55;
if (adx > 30 && bb > 2.5) {
regime = diP > diM ? “up” : “down”;
conf = Math.min(94, 60 + (adx - 30) * 1.5);
} else if (adx > 22 && Math.abs(change) > 3) {
regime = change > 0 ? “up” : “down”;
conf = Math.min(80, 55 + Math.abs(change) * 2);
} else {
conf = Math.min(90, 62 + (24 - Math.min(adx, 24)) * 1.2);
}

return {
regime, conf: Math.max(45, conf),
adx: adx.toFixed(1), diP: diP.toFixed(1), diM: diM.toFixed(1),
bb: bb.toFixed(2), rsi: r.toFixed(1),
e20: e20.toFixed(2), e50: e50.toFixed(2),
emaDiff: emaDiff.toFixed(2), atrPct: atrPct.toFixed(3),
price, change: change.toFixed(2),
};
}

// ── Claude AI call ────────────────────────────────────────
async function callAI(d, symbol, interval) {
const regimeJa = d.regime === “range” ? “レンジ相場” : d.regime === “up” ? “上昇トレンド” : “下降トレンド”;
const prompt = `あなたはプロの仮想通貨トレーダーです。以下のデータを元に相場を分析してください。

通貨: ${symbol} / 時間足: ${interval}
判定: ${regimeJa}（確信度${d.conf.toFixed(0)}%）
ADX: ${d.adx} | DI+: ${d.diP} DI-: ${d.diM}
BB幅: ${d.bb}% | RSI: ${d.rsi}
EMA20: $${d.e20} / EMA50: $${d.e50} | 乖離: ${d.emaDiff}%
ATR比率: ${d.atrPct}% | 価格変化: ${d.change}%
現在値: $${d.price.toLocaleString()}

①判断根拠 ②いま注目すべき点 ③相場転換のサインを、合計250〜320字で簡潔にプロらしく解説してください。`;

const res = await fetch(“https://api.anthropic.com/v1/messages”, {
method: “POST”,
headers: { “Content-Type”: “application/json” },
body: JSON.stringify({
model: “claude-sonnet-4-20250514”,
max_tokens: 1000,
messages: [{ role: “user”, content: prompt }],
}),
});
if (!res.ok) throw new Error(“AI APIエラー”);
const data = await res.json();
return data.content[0].text;
}

